<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>default</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <!--
          No GeneratePackageOnBuild: it makes "dotnet pack" skip the build, so packing a configuration
          that has not been built yet fails with NU5026 instead of building it. Run
          "dotnet pack -c Release" to produce the package.
        -->
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>EntityLengths.Generator</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>
            A C# source generator that automatically generates string length constants from Entity Framework configurations and data annotations.
        </Description>
        <Version>1.1.2</Version>
        <Authors>Taras Kovalenko</Authors>
        <Copyright>Copyright Taras Kovalenko</Copyright>
        <PackageTags>sourcegenerator;entityframework;stringlength;constants</PackageTags>
        <Product>EntityLengths.Generator</Product>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/TarasKovalenko/EntityLengths.Generator</PackageProjectUrl>
        <RepositoryUrl>https://github.com/TarasKovalenko/EntityLengths.Generator.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <NoPackageAnalysis>false</NoPackageAnalysis>
    </PropertyGroup>

    <ItemGroup>
        <!-- Makes the EntityLengths* MSBuild properties visible to the generator in consuming projects. -->
        <None Include="build\EntityLengths.Generator.targets" Pack="true" PackagePath="build\$(PackageId).targets"/>
        <None Include="build\EntityLengths.Generator.targets" Pack="true" PackagePath="buildTransitive\$(PackageId).targets"/>
    </ItemGroup>

    <!--
      Packs the analyzer from $(TargetPath) inside the pack pipeline, which runs after the build and
      resolves the right configuration and target framework. Pointing a None item at $(OutputPath)
      instead depends on that path already holding a build.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssembly
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="PackAnalyzerAssembly">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <!-- Versions come from Directory.Packages.props (central package management). -->
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="NETStandard.Library" PrivateAssets="all"/>
        <!--
          PrivateAssets="all" keeps Roslyn out of the package dependencies. Without it the package
          forces its own Microsoft.CodeAnalysis.CSharp range onto every consumer, which collides with
          anything else that pulls Roslyn in - Microsoft.EntityFrameworkCore.Design, for example -
          and fails the restore with NU1107. The compiler already provides Roslyn to analyzers.
        -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"
                          PrivateAssets="all"
                          ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EntityLengths.Generator.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Analyzer release tracking for the ELG* diagnostics. -->
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
