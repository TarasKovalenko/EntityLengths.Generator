<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The generator itself targets netstandard2.0 and must keep a low Roslyn floor: this version is
          the minimum compiler a consuming project needs. No upper bound - the reference is private, so
          it never reaches consumers, and capping it only ever broke restores that pulled in a newer
          Roslyn through another package.
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>

    <!--
      EF Core follows the target framework, so multi-targeted projects exercise the generator against
      every supported EF Core line instead of only the newest one.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0"/>
    </ItemGroup>

</Project>
